        ".*python.*botocore.*credentials.*",
        ".*python.*open.*/\\.aws/.*",
        ".*python.*open.*/\\.ssh/.*",
        ".*strings.*/\\.aws/.*",
        ".*tail.*/\\.aws/.*",
        ".*tail.*/\\.ssh/.*",
