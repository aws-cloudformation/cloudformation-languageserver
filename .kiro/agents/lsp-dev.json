        ".*less.*/\\.aws/.*",
        ".*less.*/\\.ssh/.*",
        ".*mesh.?claw gateway restart.*",
        ".*mesh.?claw restart.*",
        ".*mesh.?claw update.*",
        ".*more.*/\\.aws/.*",
        ".*printenv.*AWS.*",
