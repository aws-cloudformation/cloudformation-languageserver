{
  "name": "lsp-dev",
  "description": "Development agent for the CloudFormation Language Server. Helps implement features, fix bugs, write tests, wire telemetry, and create PRs across the CFN LSP ecosystem.",
  "model": "claude-opus-4.6",
  "prompt": "You are an expert TypeScript/Kotlin developer specializing in the CloudFormation Language Server Extension. You help implement features, fix bugs, write tests, wire telemetry, and create PRs across the entire CFN LSP Experience ecosystem.\n\nFollow the development workflow in `.kiro/skills/cfn-lsp-development/SKILL.md`.\n\nRead architecture docs in `.kiro/steering/` before making structural decisions.",
  "tools": [
    "read",
    "write",
    "shell",
    "code",
    "glob",
    "grep",
    "web_fetch",
    "web_search",
    "knowledge",
    "subagent"
  ],
  "allowedTools": [
    "read",
    "code",
    "glob",
    "grep",
    "web_fetch",
    "web_search",
    "knowledge"
  ],
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        "^npm run lint.*$",
        "^npm run test.*$",
        "^npm run compile.*$",
        "^npm run bundle.*$",
        "^npm ci$",
        "^npm install$",
        "^npx vitest.*$",
        "^git (status|diff|log|branch|stash).*$",
        "^git clone .*$"
      ],
      "deniedCommands": [
        ".*base64.*/\\.aws/.*",
        ".*cat.*/\\.aws/.*",
        ".*cat.*/\\.docker/config\\.json.*",
        ".*cat.*/\\.git-credentials.*",
        ".*cat.*/\\.gnupg/.*",
        ".*cat.*/\\.gpg/.*",
        ".*cat.*/\\.kube/config.*",
        ".*cat.*/\\.meshclaw/\\.env.*",
        ".*cat.*/\\.netrc.*",
        ".*cat.*/\\.npmrc.*",
        ".*cat.*/\\.pypirc.*",
        ".*cat.*/\\.ssh/.*",
        ".*cp.*/\\.aws/.*",
        ".*cp.*/\\.ssh/.*",
        ".*curl.*169\\.254\\.169\\.254.*",
        ".*curl.*\\$AWS_ACCESS.*",
        ".*curl.*\\$AWS_SECRET.*",
        ".*curl.*\\$AWS_SESSION.*",
        ".*echo.*\\$AWS_ACCESS.*",
        ".*echo.*\\$AWS_SECRET.*",
        ".*echo.*\\$AWS_SESSION.*",
        ".*env.*grep.*AWS.*",
        ".*head.*/\\.aws/.*",
        ".*head.*/\\.ssh/.*",
        ".*kill.*mesh.?claw.*",
        ".*less.*/\\.aws/.*",
        ".*less.*/\\.ssh/.*",
        ".*mesh.?claw gateway restart.*",
        ".*mesh.?claw restart.*",
        ".*mesh.?claw update.*",
        ".*more.*/\\.aws/.*",
        ".*printenv.*AWS.*",
        ".*python.*boto3.*get_credentials.*",
        ".*python.*botocore.*credentials.*",
        ".*python.*open.*/\\.aws/.*",
        ".*python.*open.*/\\.ssh/.*",
        ".*strings.*/\\.aws/.*",
        ".*tail.*/\\.aws/.*",
        ".*tail.*/\\.ssh/.*",
        ".*wget.*169\\.254\\.169\\.254.*",
        "DROP DATABASE.*",
        "DROP TABLE.*",
        "TRUNCATE TABLE.*",
        "chmod 777.*",
        "curl .* \\| bash",
        "curl .* \\| sh",
        "dd if=.*",
        "export AWS_ACCESS.*",
        "export AWS_SECRET.*",
        "git push.*(-f|--force|--force-with-lease).*",
        "git reset --hard.*",
        "mkfs.*",
        "nc -e.*",
        "ncat -e.*",
        "rm -rf /.*",
        "rm -rf ~.*",
        "wget .* \\| bash"
      ],
      "autoAllowReadonly": true,
      "denyByDefault": false
    },
    "shell": {
      "deniedCommands": [
